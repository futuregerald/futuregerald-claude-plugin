{
  "autonomous-circuit-breaker": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash ~/.gemini/config/hooks/autonomous-breaker.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "read_file"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.gemini/config/hooks/autonomous-breaker.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "view_file"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.gemini/config/hooks/autonomous-breaker.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "run_command"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.gemini/config/hooks/autonomous-breaker.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "call_mcp_tool"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.gemini/config/hooks/autonomous-breaker.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "edit_file"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.gemini/config/hooks/autonomous-breaker.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "replace_file_content"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.gemini/config/hooks/autonomous-breaker.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "write_file"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.gemini/config/hooks/autonomous-breaker.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "write_to_file"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.gemini/config/hooks/autonomous-breaker.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "invoke_subagent"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.gemini/config/hooks/autonomous-breaker.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "send_message"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.gemini/config/hooks/autonomous-breaker.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "grep_search"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.gemini/config/hooks/autonomous-breaker.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "list_dir"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.gemini/config/hooks/autonomous-breaker.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "find_by_name"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.gemini/config/hooks/autonomous-breaker.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "search_web"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.gemini/config/hooks/autonomous-breaker.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "read_url_content"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.gemini/config/hooks/autonomous-breaker.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "manage_task"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.gemini/config/hooks/autonomous-breaker.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "schedule"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.gemini/config/hooks/autonomous-breaker.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "swarm"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.gemini/config/hooks/autonomous-breaker.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "read_board"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.gemini/config/hooks/autonomous-breaker.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "post_message"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.gemini/config/hooks/autonomous-breaker.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "swarm_wait"
      }
    ],
    "enabled": true
  },
  "prism-memory": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "python3 ~/.gemini/config/hooks/prism_memory_hook.py --dialect agy --event PostToolUse",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "edit_file|replace_file_content|write_file|write_to_file|call_mcp_tool"
      }
    ],
    "SessionStart": [
      {
        "command": "python3 ~/.gemini/config/hooks/prism_memory_hook.py --dialect agy --event SessionStart",
        "timeout": 5,
        "type": "command"
      }
    ],
    "Stop": [
      {
        "command": "python3 ~/.gemini/config/hooks/prism_memory_hook.py --dialect agy --event Stop",
        "timeout": 10,
        "type": "command"
      }
    ],
    "enabled": true
  }
}
